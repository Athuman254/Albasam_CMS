<template>
  <DefaultLayout>
    <Head title="Manage Fees" />
    
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">Manage Fees</h4>
                        <Link 
                            :href="route('admin.fees.create')" 
                            class="btn btn-primary"
                        >
                            <i class="fas fa-plus me-1"></i> Create Fee
                        </Link>
                    </div>
                    <div class="card-body">
                        <!-- Success Message -->
                        <div v-if="flashSuccess" class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            {{ flashSuccess }}
                            <button type="button" class="btn-close" @click="clearFlashSuccess"></button>
                        </div>

                        <!-- Error Message -->
                        <div v-if="flashError" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            {{ flashError }}
                            <button type="button" class="btn-close" @click="clearFlashError"></button>
                        </div>

                        <div v-if="!fees || fees.data?.length === 0" class="text-center py-5">
                            <div class="empty-state">
                                <i class="fas fa-money-bill-wave fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">No Fees Found</h4>
                                <p class="text-muted mb-4">Get started by creating your first fee record</p>
                                <Link 
                                    :href="route('admin.fees.create')" 
                                    class="btn btn-primary btn-lg"
                                >
                                    <i class="fas fa-plus me-2"></i> Create Your First Fee
                                </Link>
                            </div>
                        </div>
                        
                        <div v-else>
                            <!-- Search and Filters -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input 
                                            type="text" 
                                            class="form-control" 
                                            placeholder="Search fees..." 
                                            v-model="searchQuery"
                                            @input="debouncedSearch"
                                        >
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select" v-model="selectedAcademicYear" @change="filterFees">
                                        <option value="">All Academic Years</option>
                                        <option v-for="year in academic_years" :key="year.id" :value="year.name">
                                            {{ year.name }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select" v-model="selectedClass" @change="filterFees">
                                        <option value="">All Classes</option>
                                        <option v-for="rank in ranks" :key="rank.id" :value="rank.id">
                                            {{ rank.name }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-outline-secondary w-100" @click="resetFilters">
                                        <i class="fas fa-refresh me-1"></i> Reset
                                    </button>
                                </div>
                            </div>

                            <!-- Fees Table -->
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">ID</th>
                                            <th>Student</th>
                                            <th>Academic Year</th>
                                            <th>Class</th>
                                            <th>Fee Type</th>
                                            <th width="120">Amount</th>
                                            <th width="120">Due Date</th>
                                            <th width="100">Status</th>
                                            <th width="150" class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-for="fee in fees.data" :key="fee.id" class="align-middle">
                                            <td class="fw-bold">#{{ fee.id }}</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div>
                                                        <div class="fw-medium">{{ fee.student?.full_name }}</div>
                                                        <small class="text-muted">{{ fee.student?.admission_number }}</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info bg-opacity-10 text-info">
                                                    {{ fee.academic_year }} <!-- Fixed: using academic_year directly -->
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary bg-opacity-10 text-primary">
                                                    {{ fee.rank?.name }} <!-- Fixed: using rank relationship -->
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-money-bill-wave text-success me-2"></i>
                                                    <span class="fw-medium">{{ formatFeeType(fee.fee_type) }}</span>
                                                </div>
                                                <small class="text-muted" v-if="fee.description">
                                                    {{ truncateText(fee.description, 30) }}
                                                </small>
                                            </td>
                                            <td class="fw-bold text-success">
                                                {{ formatCurrency(fee.amount) }}
                                            </td>
                                            <td>
                                                <span :class="{'text-danger': isOverdue(fee.due_date)}">
                                                    <i class="fas fa-calendar me-1"></i>
                                                    {{ formatDate(fee.due_date) }}
                                                </span>
                                            </td>
                                            <td>
                                                <span :class="`badge bg-${getStatusBadge(fee.status)}`">
                                                    <i :class="getStatusIcon(fee.status)" class="me-1"></i>
                                                    {{ formatStatus(fee.status) }}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <Link 
                                                        :href="route('admin.fees.edit', fee.id)"
                                                        class="btn btn-outline-warning"
                                                        :title="`Edit ${fee.fee_type}`"
                                                    >
                                                        <i class="fas fa-edit"></i>
                                                    </Link>
                                                    <button 
                                                        @click="deleteFee(fee)"
                                                        class="btn btn-outline-danger"
                                                        :title="`Delete ${fee.fee_type}`"
                                                        :disabled="isDeleting"
                                                    >
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                    <Link 
                                                        :href="route('admin.fees.show', fee.id)"
                                                        class="btn btn-outline-info"
                                                        :title="`View ${fee.fee_type} details`"
                                                    >
                                                        <i class="fas fa-eye"></i>
                                                    </Link>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Table Summary -->
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <p class="text-muted mb-0">
                                        Showing {{ fees.from || 0 }} to {{ fees.to || 0 }} of {{ fees.total || 0 }} entries
                                    </p>
                                </div>
                                <div class="col-md-6 text-end">
                                    <p class="text-muted mb-0">
                                        Total Amount: <span class="fw-bold text-success">{{ calculateTotalAmount() }}</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Pagination -->
                            <div v-if="fees.meta && fees.meta.last_page > 1" class="mt-4">
                                <nav aria-label="Fees pagination">
                                    <ul class="pagination justify-content-center mb-0">
                                        <li 
                                            v-for="link in fees.meta.links" 
                                            :key="link.label"
                                            :class="['page-item', { 
                                                active: link.active, 
                                                disabled: !link.url 
                                            }]"
                                        >
                                            <Link 
                                                :href="link.url || '#'" 
                                                class="page-link"
                                                v-html="link.label"
                                                preserve-scroll
                                            />
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </DefaultLayout>
</template>

<script setup>
import DefaultLayout from '@/Layouts/DefaultLayout.vue';
import { Head, Link, router, usePage } from '@inertiajs/vue3';
import { ref, computed, onMounted } from 'vue';

const props = defineProps({
    fees: Object,
    academic_years: Array,
    ranks: Array,
    filters: Object
});

// Use usePage to safely access page props
const page = usePage();

// Reactive data
const searchQuery = ref(props.filters?.search || '');
const selectedAcademicYear = ref(props.filters?.academic_year || '');
const selectedClass = ref(props.filters?.class || '');
const isDeleting = ref(false);

// Safely access flash messages
const flashSuccess = computed(() => page.props.flash?.success);
const flashError = computed(() => page.props.flash?.error);

// Clear flash messages
const clearFlashSuccess = () => {
    if (page.props.flash) {
        page.props.flash.success = null;
    }
};

const clearFlashError = () => {
    if (page.props.flash) {
        page.props.flash.error = null;
    }
};

// Helper methods - FIXED VERSION
const formatFeeType = (feeType) => {
    if (!feeType) return 'N/A';
    return feeType.charAt(0).toUpperCase() + feeType.slice(1) + ' Fee';
};

const formatCurrency = (amount) => {
    if (!amount || isNaN(amount)) return 'Ksh 0.00';
    return new Intl.NumberFormat('en-KE', {
        style: 'currency',
        currency: 'KES',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    }).format(amount);
};

const formatDate = (dateString) => {
    if (!dateString) return 'N/A';
    return new Date(dateString).toLocaleDateString('en-KE', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
};

const formatStatus = (status) => {
    if (!status) return 'Pending';
    return status.charAt(0).toUpperCase() + status.slice(1);
};

const getStatusIcon = (status) => {
    const statusIcons = {
        'paid': 'fas fa-check-circle',
        'partial': 'fas fa-clock',
        'pending': 'fas fa-hourglass-half',
        'overdue': 'fas fa-exclamation-circle',
        'carried_over': 'fas fa-forward'
    };
    return statusIcons[status?.toLowerCase()] || 'fas fa-circle';
};

const getStatusBadge = (status) => {
    const statusMap = {
        'paid': 'success',
        'partial': 'warning',
        'pending': 'secondary',
        'overdue': 'danger',
        'carried_over': 'info'
    };
    return statusMap[status?.toLowerCase()] || 'secondary';
};

const isOverdue = (dueDate) => {
    if (!dueDate) return false;
    return new Date(dueDate) < new Date();
};

const truncateText = (text, length) => {
    if (!text) return '';
    return text.length > length ? text.substring(0, length) + '...' : text;
};

const calculateTotalAmount = () => {
    if (!props.fees?.data) return formatCurrency(0);
    const total = props.fees.data.reduce((sum, fee) => sum + parseFloat(fee.amount), 0);
    return formatCurrency(total);
};

// Simple debounce implementation
const debounce = (func, wait) => {
    let timeout;
    return function executedFunction(...args) {
        const later = () => {
            clearTimeout(timeout);
            func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
};

// Search with debounce
const debouncedSearch = debounce(() => {
    filterFees();
}, 500);

// Filter methods
const filterFees = () => {
    router.get(route('admin.fees.index'), {
        search: searchQuery.value,
        academic_year: selectedAcademicYear.value,
        class: selectedClass.value
    }, {
        preserveState: true,
        replace: true
    });
};

const resetFilters = () => {
    searchQuery.value = '';
    selectedAcademicYear.value = '';
    selectedClass.value = '';
    filterFees();
};

// Show confirmation dialog (using browser confirm)
const showConfirmation = async (title, text) => {
    return window.confirm(`${title}\n\n${text}`);
};

// Show message (using browser alert)
const showMessage = (title, text) => {
    window.alert(`${title}\n\n${text}`);
};

// Delete fee method
const deleteFee = async (fee) => {
    const confirmed = await showConfirmation(
        'Are you sure?',
        `You are about to delete "${formatFeeType(fee.fee_type)}" for ${fee.student?.full_name}. This action cannot be undone.`
    );
    
    if (confirmed) {
        isDeleting.value = true;
        
        router.delete(route('admin.fees.destroy', fee.id), {
            preserveScroll: true,
            onSuccess: () => {
                showMessage('Deleted!', 'Fee has been deleted successfully.');
            },
            onError: () => {
                showMessage('Error!', 'Something went wrong while deleting the fee.');
            },
            onFinish: () => {
                isDeleting.value = false;
            }
        });
    }
};

// Initialize on mount
onMounted(() => {
    // Set initial filter values from props
    if (props.filters) {
        searchQuery.value = props.filters.search || '';
        selectedAcademicYear.value = props.filters.academic_year || '';
        selectedClass.value = props.filters.class || '';
    }
    
    console.log('Fees data:', props.fees);
    console.log('Academic years:', props.academic_years);
    console.log('Ranks:', props.ranks);
});
</script>

<style scoped>
.empty-state {
    padding: 3rem 0;
}

.card-header {
    color: white;
    border-bottom: none;
}

.card-header .card-title {
    color: white;
}

.card-header .btn-primary {
    background-color: blue;
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
}

.card-header .btn-primary:hover {
    background-color: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.4);
}

.table th {
    border-top: none;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
}

.badge {
    font-size: 0.75em;
    font-weight: 500;
}

.btn-group .btn {
    border-radius: 0.375rem;
    margin: 0 2px;
}

.btn-group .btn:first-child {
    border-top-left-radius: 0.375rem;
    border-bottom-left-radius: 0.375rem;
}

.btn-group .btn:last-child {
    border-top-right-radius: 0.375rem;
    border-bottom-right-radius: 0.375rem;
}

.page-item.active .page-link {
    background-color: #667eea;
    border-color: #667eea;
}

.page-link {
    color: #667eea;
}

.page-link:hover {
    color: #5a6fd8;
}

.alert {
    border: none;
    border-left: 4px solid;
}

.alert-success {
    border-left-color: #198754;
    background-color: #f8fff9;
}

.alert-danger {
    border-left-color: #dc3545;
    background-color: #fff8f8;
}

.table-hover tbody tr:hover {
    background-color: rgba(102, 126, 234, 0.04);
}
</style>